{
  "name": "fumadocs-pdf-export",
  "version": "1.2.1-exp.6",
  "description": "PDF export plugin for Fumadocs documentation sites",
  "homepage": "https://github.com/sebastianhuus/fumadocs-pdf-export",
  "license": "MIT",
  "author": "Sebastian Huus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastianhuus/fumadocs-pdf-export.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fumadocs-pdf": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles/print.css": "./dist/styles/print.css",
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp -r src/styles dist/",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fumadocs",
    "pdf",
    "export",
    "documentation",
    "print",
    "next.js"
  ],
  "peerDependencies": {
    "next": ">=14.0.0",
    "puppeteer": ">=22.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^15.0.0",
    "puppeteer": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
